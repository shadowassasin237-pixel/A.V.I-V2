# A.V.I. environment configuration
# Copy this file to .env and fill in your own credentials.

AVI_LANGUAGE=en-IN
AVI_TTS_RATE=175
AVI_TTS_VOLUME=1.0
AVI_WEB_MAX_RESULTS=5

OPENROUTER_API_KEY=
AVI_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
AVI_LLM_BASE_URL=https://openrouter.ai/api/v1
AVI_APP_NAME=A.V.I.
AVI_SITE_URL=

# Required for the LiveKit -> Inworld Priya/Arjun voice path.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=avi-room
LIVEKIT_AGENT_NAME=avi

# No separate Inworld API key is required when using LiveKit Inference.
# Default voice is "Arjun" (Indian English male). Other options:
#   Priya  - even-toned Indian English female
#   Ashley - warm American female
#   Alex   - energetic American male
#   Dennis - calm American male
# See https://docs.livekit.io/agents/models/tts/inworld/ for the full list.
